+
+test('X05 arquivo corrompido (linha cortada): falha fechada, a proxima mensagem nao se grava', () => {
+  const raiz = pasta();
+  R().registrar(saida(1), { raiz, agora: '2026-10-14T13:00:00.000Z' });
