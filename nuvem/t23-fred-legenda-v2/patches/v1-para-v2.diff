+def tempos_destaque(g: list[Palavra], fim_bloco: float, minimo: float = 0.08) -> list[tuple[float, float]]:
+    """(início, fim) do destaque de cada palavra do bloco, todos com duração > 0. O Whisper às vezes dá duração zero
