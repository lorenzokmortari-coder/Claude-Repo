+/**
+ * As mensagens nossas de iniciativa (nao resposta) no PRIVADO nos ultimos `dias` que a pessoa ainda nao respondeu:
+ * nenhuma fala dela (de_mim = 0) no banco da captura depois do envio. {mensagens, contatos}, ou null sem banco.
+ */
+function semResposta(agora = Date.now(), db, dias = 30) {
+  if (!db) return null;
+  const envios = livro(agora - dias * 86400e3).filter((x) => ehEnvio(x) && !x.resposta && x.jid && !/@g\.us$/.test(String(x.jid)));
+  const ultimaDeles = new Map();
+  let mensagens = 0;
+  const contatos = new Set();
+  try {
+    for (const x of envios) {
+      const jid = String(x.jid);
+      if (!ultimaDeles.has(jid)) {
+        const base = jid.split('@')[0].split(':')[0];
+        const r = db.prepare('SELECT MAX(ts) AS t FROM mensagens WHERE de_mim = 0 AND (jid = ? OR jid LIKE ?)').get(jid, base + '@%');
+        ultimaDeles.set(jid, r && r.t ? Number(r.t) : 0);
+      }
+      if (ultimaDeles.get(jid) * 1000 <= Date.parse(x.em)) {
+        mensagens++;
+        contatos.add(jid);
+      }
+    }
+  } catch {
+    return null;
+  }
+  return { mensagens, contatos: contatos.size, dias };
 }
 
