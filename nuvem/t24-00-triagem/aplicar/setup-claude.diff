diff -ruN a/hooks/automacao/guarda/guarda.js b/hooks/automacao/guarda/guarda.js
--- /dev/null
+++ b/hooks/automacao/guarda/guarda.js
@@ -0,0 +1,33 @@
+// GUARDA DAS PASTAS PROTEGIDAS (14/10/2026, auditoria da nuvem, tarefa 16): hook PreToolUse do Bash.
+//
+// O settings.json nega o Read de ~/.ozav (chaves), veedha-dados (cliente PF da Veedha) e financas/originais. Mas o
+// "Bash(cat:*)" liberado, e o bypass que e o padrao, deixam ler o mesmo arquivo pelo terminal (cat, type, grep, head,
+// Get-Content, ssh "cat ~/.ozav/.env"): o conteudo entra na conversa e no transcript, que o backup do ~/.claude copia.
+// Este hook barra o comando que cita essas pastas. Nao muda o bypass: so esse comando para.
+//
+//   settings.json > hooks > PreToolUse: { "matcher": "Bash", "hooks": [{ "type": "command",
+//     "command": "node \"<HOME>/OneDrive/Claude/automacao/guarda/guarda.js\"", "timeout": 5 }] }
+//
+// Sai 2 com o motivo no stderr (o Claude Code bloqueia a ferramenta e mostra o motivo ao modelo). Script do motor que
+// le essas pastas por dentro (node coletar.js) passa: o hook olha so o texto do comando. Erro do proprio hook sai 0.
+const fs = require('fs');
+
+const PROTEGIDAS = [
+  [/(^|[\\/"'\s~])\.ozav([\\/"'\s]|$)/i, '~/.ozav (as chaves)'],
+  [/veedha-dados/i, 'veedha-dados (cliente pessoa fisica da Veedha)'],
+  [/financas[\\/]+originais/i, 'financas/originais (financas pessoais)'],
+];
+
+try {
+  const inp = JSON.parse(fs.readFileSync(0, 'utf8'));
+  const cmd = String((inp.tool_input && inp.tool_input.command) || '');
+  const achou = PROTEGIDAS.find(([re]) => re.test(cmd));
+  if (achou) {
+    process.stderr.write(`Bloqueado pela guarda: o comando cita ${achou[1]}, pasta que o settings.json nega para leitura. ` +
+      'Se precisar de um numero dali (quantas chaves, quantas linhas), peca ao dono ou use o script do motor que ja le a pasta.\n');
+    process.exit(2);
+  }
+} catch {
+  /* entrada ilegivel: deixa passar */
+}
+process.exit(0);
diff -ruN a/hooks/claude-hooks/nonstop.sh b/hooks/claude-hooks/nonstop.sh
--- a/hooks/claude-hooks/nonstop.sh
+++ b/hooks/claude-hooks/nonstop.sh
@@ -18,13 +18,16 @@
 input=$(cat)
 
 # --- Extract session_id and stop_hook_active ---
-# shellcheck disable=SC2154  # variables assigned via eval
-eval "$(echo "$input" | python -c "
-import sys, json
-d = json.load(sys.stdin)
-print(f'session_id={d.get(\"session_id\", \"default\")}')
-print(f'stop_hook_active={str(d.get(\"stop_hook_active\", False)).lower()}')
-" 2>/dev/null)"
+# 14/10/2026, auditoria da nuvem: sem python. No Windows o python/python3 do PATH pode ser o atalho da Microsoft
+# Store (nao roda, nao imprime nada): o session_id saia vazio, o modo virava "nonstop-.active", um so para todas as
+# conversas, e o stop_hook_active vazio desligava a trava contra laco. Aqui so bash, e sem eval.
+session_id=""; stop_hook_active=false
+re_sid='"session_id"[[:space:]]*:[[:space:]]*"([A-Za-z0-9_-]+)"'
+re_sha='"stop_hook_active"[[:space:]]*:[[:space:]]*true'
+[[ $input =~ $re_sid ]] && session_id=${BASH_REMATCH[1]}
+[[ $input =~ $re_sha ]] && stop_hook_active=true
+# sem session_id nao da para saber de quem e o modo: deixa parar
+[ -n "$session_id" ] || exit 0
 
 # shellcheck disable=SC2154
 active_file="$STATE_DIR/nonstop-${session_id}.active"
