+#!/bin/bash
+# RESTAURAR O ESTADO DA OZAV NO LUGAR CERTO (14/10/2026, auditoria da nuvem, tarefa 15).
+#
+# O backup.sh monta o pacote com tres raizes (-C ~, -C ~/ozav-crm, -C ~/ozav-marketing). O comando do
+# INFRAESTRUTURA ("tar xzf <pacote> -C ~") poe mensagens.db, telegram/, *.jsonl e estado/ na raiz da home:
+# os robos sobem sem historico, sem a sessao do Telegram e sem o que ja foi publicado, e ninguem percebe.
+# Este script abre o pacote numa pasta temporaria, roda a prova do proprio backup.sh e so entao copia cada
+# parte para a sua raiz. O que ja existia no destino fica como <nome>.antes-restaurar.
+#
+#   bash restaurar-estado.sh <estado-AAAAMMDD.tgz>           confere e restaura (com a captura parada)
+#   bash restaurar-estado.sh <estado-AAAAMMDD.tgz> --seco    so mostra o que faria
+#
+# Na VPS nova vem ANTES do deploy (sem ~/.ozav/.env o segredos.sh do deploy falha e o cron sobe sem os grupos):
+# copie do PC o pacote, este script e o backup.sh para a mesma pasta e rode daqui.
+#
+# Depois: na VPS nova, o deploy do PC (ele roda o segredos.sh); numa VPS que ja tem o deploy, segredos.sh e rodar.sh captura.
+set -u
+PACOTE="${1:-}"
+SECO="${2:-}"
+[ -f "$PACOTE" ] || { echo "uso: restaurar-estado.sh <estado-AAAAMMDD.tgz> [--seco]"; exit 2; }
+RAIZ="$HOME/ozav-crm"
+MKT="$HOME/ozav-marketing"
+
+# o mesmo pareamento em dois processos derruba a sessao (o 440 de 08/09): nada de restaurar com a captura de pe
+if pgrep -u "$(id -u)" -f "conectar\.js" >/dev/null 2>&1; then
+  echo "a captura esta de pe: pare os robos antes de restaurar"
+  exit 1
+fi
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+tar xzf "$PACOTE" -C "$TMP" || { echo "FALHA: o pacote nao abre"; exit 1; }
+# a prova: o backup.sh ao lado deste script (VPS nova, antes do deploy: os dois vieram do PC junto com o pacote)
+# ou o do deploy. Precisa do node em ~/.local/node.
+PROVA_SH="$(dirname "$0")/backup.sh"
+[ -f "$PROVA_SH" ] || PROVA_SH="$RAIZ/deploy/backup.sh"
+if [ -f "$PROVA_SH" ]; then
+  bash "$PROVA_SH" --restaurar "$PACOTE" >"$TMP.prova" 2>&1 || { echo "FALHA: o pacote nao passou na prova (backup.sh --restaurar):"; tail -3 "$TMP.prova"; rm -f "$TMP.prova"; exit 1; }
+  rm -f "$TMP.prova"
+else
+  echo "aviso: sem o backup.sh ao lado nem no deploy, restauro sem a prova"
+fi
+
+mover() { # parte (relativa ao pacote) -> destino absoluto
+  local o="$TMP/$1" d="$2"
+  [ -e "$o" ] || return 0
+  echo "  $1 -> $d"
+  [ -n "$SECO" ] && return 0
+  mkdir -p "$(dirname "$d")"
+  if [ -e "$d" ]; then
+    rm -rf "$d.antes-restaurar"
+    mv "$d" "$d.antes-restaurar"
+  fi
+  cp -a "$o" "$d"
+}
+
+# raiz 1: a home
+mover .ozav "$HOME/.ozav"
+mover whatsapp-auth "$HOME/whatsapp-auth"
+# raiz 2: ~/ozav-crm
+for x in whatsapp/dados/mensagens.db whatsapp/auth telegram/credenciais.json telegram/sessao.txt robos-desligados.json pen-numeros.json \
+         conduzir-config.json feriados.txt silencio.txt decidir-vistas.json plano-estado.json hunting-bc-estado.json fechamento-estado.json \
+         whatsapp-governador.json catraca-regras.json; do
+  mover "$x" "$RAIZ/$x"
+done
+for f in "$TMP"/*.jsonl; do
+  [ -e "$f" ] && mover "$(basename "$f")" "$RAIZ/$(basename "$f")"
+done
+# raiz 3: ~/ozav-marketing
+mover estado "$MKT/estado"
+
+if [ -n "$SECO" ]; then
+  echo "(seco: nada foi copiado)"
+  exit 0
+fi
+chmod 700 "$HOME/.ozav" 2>/dev/null
+find "$HOME/.ozav" -type f -exec chmod 600 {} + 2>/dev/null
+echo "restaurado. Proximo: VPS nova = o deploy do PC; VPS com deploy = bash ~/ozav-crm/deploy/segredos.sh e bash ~/ozav-crm/deploy/rodar.sh captura"
