--- /dev/null
+++ b/pc/vigiar-vps.js
@@ -0,0 +1,101 @@
+#!/usr/bin/env node
+/**
+ * VIGIA DE FORA DA VPS (14/10/2026, auditoria da nuvem, tarefa 15).
+ *
+ * Todo aviso do servidor sai do próprio servidor: Slack pelo token preso ao IP dele, WhatsApp pelas sessões
+ * guardadas nele. Se a VPS cai inteira (contrato que não renovou, disco cheio, kernel, Tailscale), ninguém avisa.
+ * Este roda no PC, de 30 em 30 min pelo Agendador de Tarefas, e olha a VPS de fora:
+ *   1. o painel do dono (porta 8778, só pela Tailscale) responde?
+ *   2. a página foi regerada há pouco? O cron do root a regera de hora em hora: o Last-Modified dela é o pulso
+ *      do cron e do root (cron parado, root sem disco ou node quebrado = página parada).
+ * Duas leituras ruins seguidas (1 h) = notificação no Windows e linha FALHA no log. Uma só não avisa (Wi-Fi do PC).
+ *
+ *   node vigiar-vps.js                                   URL do VPS_PAINEL_URL, ou http://<IP_TAILSCALE>:8778/
+ *   node vigiar-vps.js --url http://... --max-min 90 --estado arquivo.json --sem-aviso
+ *
+ * Sai 0 = ok · 1 = ruim pela primeira vez (só registra) · 2 = ruim de novo (avisou) · 3 = erro de uso.
+ * Sem dependência de npm. Não lê nada do servidor além do cabeçalho da página.
+ */
+'use strict';
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const { spawnSync } = require('child_process');
+
+function opcoes(argv) {
+  const o = { url: process.env.VPS_PAINEL_URL || 'http://<IP_TAILSCALE>:8778/', maxMin: 90, estado: path.join(os.homedir(), '.vigiar-vps.json'), semAviso: false, timeoutMs: 15000 };
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i];
+    if (a === '--url') o.url = argv[++i];
+    else if (a === '--max-min') o.maxMin = Number(argv[++i]);
+    else if (a === '--estado') o.estado = argv[++i];
+    else if (a === '--timeout-ms') o.timeoutMs = Number(argv[++i]);
+    else if (a === '--sem-aviso') o.semAviso = true;
+    else throw new Error(`opcao desconhecida: ${a}`);
+  }
+  if (!/^http:\/\//.test(o.url) || o.url.includes('<')) throw new Error(`URL do painel nao configurada: ${o.url} (use --url ou VPS_PAINEL_URL)`);
+  if (!(o.maxMin > 0)) throw new Error('--max-min tem de ser positivo');
+  return o;
+}
+
+/** Uma leitura: { ok, motivo }. */
+function ler(url, maxMin, timeoutMs) {
+  return new Promise((resolve) => {
+    const req = http.get(url, { timeout: timeoutMs }, (res) => {
+      res.resume();
+      if (res.statusCode !== 200) return resolve({ ok: false, motivo: `painel respondeu ${res.statusCode}` });
+      const lm = Date.parse(res.headers['last-modified'] || '');
+      if (!Number.isFinite(lm)) return resolve({ ok: false, motivo: 'painel sem Last-Modified: nao da para saber se o cron gira' });
+      const min = Math.round((Date.now() - lm) / 60000);
+      if (min > maxMin) return resolve({ ok: false, motivo: `pagina parada ha ${min} min (o cron do root regera de hora em hora)` });
+      resolve({ ok: true, motivo: `pagina de ${min} min atras` });
+    });
+    req.on('timeout', () => req.destroy(new Error('sem resposta')));
+    req.on('error', (e) => resolve({ ok: false, motivo: `sem resposta (${e.code || e.message}): VPS, Tailscale ou painel fora` }));
+  });
+}
+
+function avisarNoWindows(texto) {
+  if (process.platform !== 'win32') return false;
+  const t = texto.replace(/'/g, "''");
+  const ps = `Add-Type -AssemblyName System.Windows.Forms; $n=New-Object System.Windows.Forms.NotifyIcon; $n.Icon=[System.Drawing.SystemIcons]::Warning; $n.Visible=$true; $n.ShowBalloonTip(20000,'VPS','${t}','Warning'); Start-Sleep 21; $n.Dispose()`;
+  return spawnSync('powershell', ['-NoProfile', '-Command', ps], { stdio: 'ignore', timeout: 30000 }).status === 0;
+}
+
+async function main() {
+  let o;
+  try {
+    o = opcoes(process.argv.slice(2));
+  } catch (e) {
+    console.error(e.message);
+    return 3;
+  }
+  let est = { ruins: 0 };
+  try {
+    est = JSON.parse(fs.readFileSync(o.estado, 'utf8'));
+  } catch {
+    /* primeira vez ou arquivo ilegivel: comeca do zero */
+  }
+  const r = await ler(o.url, o.maxMin, o.timeoutMs);
+  const agora = new Date().toISOString();
+  if (r.ok) {
+    fs.writeFileSync(o.estado, JSON.stringify({ ruins: 0, ultimoOk: agora }));
+    console.log(`${agora} ok: ${r.motivo}`);
+    return 0;
+  }
+  const ruins = (Number(est.ruins) || 0) + 1;
+  fs.writeFileSync(o.estado, JSON.stringify({ ruins, ultimoOk: est.ultimoOk || null, ultimoRuim: agora, motivo: r.motivo }));
+  if (ruins < 2) {
+    console.log(`${agora} ruim (1a vez, ainda nao aviso): ${r.motivo}`);
+    return 1;
+  }
+  const texto = `A VPS nao esta bem: ${r.motivo}. Ultimo ok: ${est.ultimoOk || 'nunca'}. Olhe o painel da Hostinger e a Tailscale.`;
+  console.log(`${agora} FALHA (${ruins}a seguida): ${texto}`);
+  if (!o.semAviso) avisarNoWindows(texto);
+  return 2;
+}
+
+if (require.main === module) main().then((c) => process.exit(c));
+module.exports = { ler, opcoes, main };
